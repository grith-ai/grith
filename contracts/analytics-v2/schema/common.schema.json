{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grith.ai/contracts/analytics-v2/schema/common.schema.json",
  "title": "Grith analytics-v2 common types",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "UtcDay": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "NonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "PositiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ScoreMicros": {
      "type": "integer",
      "minimum": -100000000,
      "maximum": 100000000
    },
    "CostMicros": {
      "$ref": "#/$defs/NonNegativeSafeInteger"
    },
    "ProjectLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-maxUtf8Bytes": 128
    },
    "ProfileLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-maxUtf8Bytes": 64
    },
    "ToolLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-maxUtf8Bytes": 64
    },
    "ProviderLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "x-maxUtf8Bytes": 32
    },
    "ModelLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-maxUtf8Bytes": 128
    },
    "FilterId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "x-maxUtf8Bytes": 64
    },
    "RecordClass": {
      "enum": ["decision", "routine_spawn", "routine_io", "noise", "llm_usage", "system"]
    },
    "Category": {
      "enum": [
        "file_read",
        "file_mutation",
        "process",
        "network_egress",
        "network_listen",
        "cross_process",
        "namespace",
        "llm",
        "system",
        "other"
      ]
    },
    "Verdict": {
      "enum": ["allow", "queue", "deny"]
    },
    "Completeness": {
      "enum": ["decisions", "spawns", "io", "all"]
    },
    "DeviceSyncStatus": {
      "enum": [
        "current",
        "stale",
        "offline",
        "sync_disabled",
        "entitlement_expired",
        "quota_rejected",
        "revoked",
        "gap"
      ]
    },
    "RequestContext": {
      "type": "object",
      "properties": {
        "protocol_version": { "const": 2 },
        "schema_version": { "const": 1 },
        "device_id": { "$ref": "#/$defs/Uuid" },
        "source_epoch": { "$ref": "#/$defs/Uuid" },
        "request_seq": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "runtime_instance_id": { "$ref": "#/$defs/Uuid" },
        "generated_at": { "$ref": "#/$defs/Timestamp" },
        "client_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "x-maxUtf8Bytes": 32
        },
        "materializer_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "completeness": { "$ref": "#/$defs/Completeness" }
      },
      "required": [
        "protocol_version",
        "schema_version",
        "device_id",
        "source_epoch",
        "request_seq",
        "runtime_instance_id",
        "generated_at",
        "client_version",
        "materializer_version",
        "completeness"
      ]
    },
    "ConsentReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consent_version": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "accepted_at": { "$ref": "#/$defs/Timestamp" }
      },
      "required": ["consent_version", "accepted_at"]
    },
    "DestinationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["team_hmac", "clear_label"] },
        "key_version": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "team_hmac_key_base64": {
          "type": "string",
          "minLength": 43,
          "maxLength": 44,
          "contentEncoding": "base64"
        },
        "effective_at": { "$ref": "#/$defs/Timestamp" }
      },
      "required": ["mode", "key_version", "team_hmac_key_base64", "effective_at"]
    },
    "ConfigVersion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config_hash": { "$ref": "#/$defs/Sha256" },
        "profile_id": { "$ref": "#/$defs/ProfileLabel" },
        "profile_version": { "$ref": "#/$defs/ProfileLabel" },
        "policy_version": { "$ref": "#/$defs/ProfileLabel" },
        "auto_allow_threshold_micros": { "$ref": "#/$defs/ScoreMicros" },
        "auto_deny_threshold_micros": { "$ref": "#/$defs/ScoreMicros" },
        "queue_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-maxUtf8Bytes": 64
        },
        "team_default_config_version": { "$ref": "#/$defs/ProfileLabel" },
        "first_seen_at": { "$ref": "#/$defs/Timestamp" },
        "last_seen_at": { "$ref": "#/$defs/Timestamp" }
      },
      "required": [
        "config_hash",
        "profile_id",
        "profile_version",
        "policy_version",
        "auto_allow_threshold_micros",
        "auto_deny_threshold_micros",
        "queue_policy",
        "team_default_config_version",
        "first_seen_at",
        "last_seen_at"
      ]
    },
    "SecurityResolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["pending", "approved", "denied", "expired", "escalated"] },
        "resolved_at": { "$ref": "#/$defs/Timestamp" },
        "resolution_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        }
      },
      "required": ["status"]
    },
    "SecurityEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": { "$ref": "#/$defs/Uuid" },
        "event_revision": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "occurred_at": { "$ref": "#/$defs/Timestamp" },
        "event_type": { "enum": ["queue", "deny", "canary", "gap"] },
        "initial_verdict": { "$ref": "#/$defs/Verdict" },
        "resolution": { "$ref": "#/$defs/SecurityResolution" },
        "session_id": { "$ref": "#/$defs/Uuid" },
        "project": { "$ref": "#/$defs/ProjectLabel" },
        "profile_id": { "$ref": "#/$defs/ProfileLabel" },
        "supervised_tool": { "$ref": "#/$defs/ToolLabel" },
        "category": { "$ref": "#/$defs/Category" },
        "score_micros": { "$ref": "#/$defs/ScoreMicros" },
        "top_filter_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/FilterId" },
          "x-canonicalOrder": "ascending UTF-8 bytes"
        },
        "enforcement_outcome_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "gap_count": { "$ref": "#/$defs/PositiveSafeInteger" },
        "chain_sequence": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "chain_hash": { "$ref": "#/$defs/Sha256" }
      },
      "required": [
        "event_id",
        "event_revision",
        "occurred_at",
        "event_type",
        "project",
        "profile_id",
        "supervised_tool",
        "category",
        "top_filter_ids"
      ],
      "allOf": [
        {
          "if": { "properties": { "event_type": { "enum": ["queue", "deny"] } } },
          "then": { "required": ["initial_verdict"] }
        },
        {
          "if": { "properties": { "event_type": { "const": "gap" } } },
          "then": { "required": ["gap_count"] }
        }
      ]
    },
    "UsageRollupRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bucket_start": { "$ref": "#/$defs/Timestamp" },
        "project": { "$ref": "#/$defs/ProjectLabel" },
        "profile_id": { "$ref": "#/$defs/ProfileLabel" },
        "config_hash": { "$ref": "#/$defs/Sha256" },
        "supervised_tool": { "$ref": "#/$defs/ToolLabel" },
        "record_class": { "$ref": "#/$defs/RecordClass" },
        "category": { "$ref": "#/$defs/Category" },
        "verdict": { "oneOf": [{ "$ref": "#/$defs/Verdict" }, { "type": "null" }] },
        "score_bin_version": { "const": 1 },
        "score_bucket": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 29 },
            { "type": "null" }
          ]
        },
        "event_count": { "$ref": "#/$defs/PositiveSafeInteger" },
        "score_sum_micros": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "x-constraint": "abs(score_sum_micros) <= event_count * 100000000; validate with overflow-safe arithmetic"
        },
        "first_event_at": { "$ref": "#/$defs/Timestamp" },
        "last_event_at": { "$ref": "#/$defs/Timestamp" }
      },
      "required": [
        "bucket_start",
        "project",
        "profile_id",
        "config_hash",
        "supervised_tool",
        "record_class",
        "category",
        "verdict",
        "score_bin_version",
        "score_bucket",
        "event_count",
        "score_sum_micros",
        "first_event_at",
        "last_event_at"
      ]
    },
    "FilterRollupRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day": { "$ref": "#/$defs/UtcDay" },
        "project": { "$ref": "#/$defs/ProjectLabel" },
        "profile_id": { "$ref": "#/$defs/ProfileLabel" },
        "config_hash": { "$ref": "#/$defs/Sha256" },
        "filter_set_version": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "filter_id": { "$ref": "#/$defs/FilterId" },
        "evaluated_events": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "triggered_events": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "denied_evaluated_events": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "denied_positive_contributions": { "$ref": "#/$defs/NonNegativeSafeInteger" }
      },
      "required": [
        "day",
        "project",
        "profile_id",
        "config_hash",
        "filter_set_version",
        "filter_id",
        "evaluated_events",
        "triggered_events",
        "denied_evaluated_events",
        "denied_positive_contributions"
      ]
    },
    "SessionDayRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day": { "$ref": "#/$defs/UtcDay" },
        "session_id": { "$ref": "#/$defs/Uuid" },
        "project": { "$ref": "#/$defs/ProjectLabel" },
        "profile_id": { "$ref": "#/$defs/ProfileLabel" },
        "config_hash": { "$ref": "#/$defs/Sha256" },
        "supervised_tool": { "$ref": "#/$defs/ToolLabel" },
        "first_event_at": { "$ref": "#/$defs/Timestamp" },
        "last_event_at": { "$ref": "#/$defs/Timestamp" },
        "decision_count": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "queue_count": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "deny_count": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "llm_calls": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "prompt_tokens": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "completion_tokens": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "cost_micros": { "$ref": "#/$defs/CostMicros" }
      },
      "required": [
        "day",
        "session_id",
        "project",
        "profile_id",
        "config_hash",
        "supervised_tool",
        "first_event_at",
        "last_event_at",
        "decision_count",
        "queue_count",
        "deny_count",
        "llm_calls",
        "prompt_tokens",
        "completion_tokens",
        "cost_micros"
      ]
    },
    "LlmRollupRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day": { "$ref": "#/$defs/UtcDay" },
        "project": { "$ref": "#/$defs/ProjectLabel" },
        "provider": { "$ref": "#/$defs/ProviderLabel" },
        "model": { "$ref": "#/$defs/ModelLabel" },
        "currency": { "const": "USD" },
        "price_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-maxUtf8Bytes": 64
        },
        "pricing_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-maxUtf8Bytes": 64
        },
        "calls": { "$ref": "#/$defs/PositiveSafeInteger" },
        "prompt_tokens": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "completion_tokens": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "cost_micros": { "$ref": "#/$defs/CostMicros" }
      },
      "required": [
        "day",
        "project",
        "provider",
        "model",
        "currency",
        "price_source",
        "pricing_version",
        "calls",
        "prompt_tokens",
        "completion_tokens",
        "cost_micros"
      ]
    },
    "DestinationRollupRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day": { "$ref": "#/$defs/UtcDay" },
        "kind": { "enum": ["domain", "host_port", "url_origin", "unix_socket_class", "other"] },
        "destination_hmac": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hmac_key_version": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "approved_display_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-maxUtf8Bytes": 128
        },
        "verdict": { "$ref": "#/$defs/Verdict" },
        "event_count": { "$ref": "#/$defs/PositiveSafeInteger" },
        "first_event_at": { "$ref": "#/$defs/Timestamp" },
        "last_event_at": { "$ref": "#/$defs/Timestamp" }
      },
      "required": [
        "day",
        "kind",
        "destination_hmac",
        "hmac_key_version",
        "verdict",
        "event_count",
        "first_event_at",
        "last_event_at"
      ]
    },
    "DaySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day": { "$ref": "#/$defs/UtcDay" },
        "day_revision": { "$ref": "#/$defs/PositiveSafeInteger" },
        "read_model_generation": { "$ref": "#/$defs/PositiveSafeInteger" },
        "state": { "enum": ["partial", "final"] },
        "source_event_count": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "first_event_at": {
          "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
        },
        "last_event_at": {
          "oneOf": [{ "$ref": "#/$defs/Timestamp" }, { "type": "null" }]
        },
        "first_chain_sequence": {
          "oneOf": [{ "$ref": "#/$defs/NonNegativeSafeInteger" }, { "type": "null" }]
        },
        "last_chain_sequence": {
          "oneOf": [{ "$ref": "#/$defs/NonNegativeSafeInteger" }, { "type": "null" }]
        },
        "last_chain_hash": {
          "oneOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }]
        },
        "usage_rows": {
          "type": "array",
          "maxItems": 20000,
          "items": { "$ref": "#/$defs/UsageRollupRow" },
          "x-canonicalOrder": "usage-v1"
        },
        "filter_rows": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/FilterRollupRow" },
          "x-canonicalOrder": "filter-v1"
        },
        "session_rows": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/SessionDayRow" },
          "x-canonicalOrder": "session-v1"
        },
        "llm_rows": {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/LlmRollupRow" },
          "x-canonicalOrder": "llm-v1"
        },
        "destination_rows": {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/DestinationRollupRow" },
          "x-canonicalOrder": "destination-v1"
        },
        "row_checksum_sha256": { "$ref": "#/$defs/Sha256" }
      },
      "required": [
        "day",
        "day_revision",
        "read_model_generation",
        "state",
        "source_event_count",
        "first_event_at",
        "last_event_at",
        "first_chain_sequence",
        "last_chain_sequence",
        "last_chain_hash",
        "usage_rows",
        "filter_rows",
        "session_rows",
        "llm_rows",
        "destination_rows",
        "row_checksum_sha256"
      ],
      "x-maxRollupRowsAcrossFamilies": 50000
    },
    "ArchiveDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day": { "$ref": "#/$defs/UtcDay" },
        "day_revision": { "$ref": "#/$defs/PositiveSafeInteger" },
        "archive_revision": { "$ref": "#/$defs/PositiveSafeInteger" },
        "projection_schema_version": { "const": 1 },
        "materializer_version": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "row_checksum_sha256": { "$ref": "#/$defs/Sha256" },
        "content_sha256": { "$ref": "#/$defs/Sha256" },
        "byte_size": { "$ref": "#/$defs/PositiveSafeInteger" },
        "row_count": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "min_event_at": { "$ref": "#/$defs/Timestamp" },
        "max_event_at": { "$ref": "#/$defs/Timestamp" },
        "first_chain_sequence": {
          "oneOf": [{ "$ref": "#/$defs/NonNegativeSafeInteger" }, { "type": "null" }]
        },
        "last_chain_sequence": {
          "oneOf": [{ "$ref": "#/$defs/NonNegativeSafeInteger" }, { "type": "null" }]
        },
        "last_chain_hash": {
          "oneOf": [{ "$ref": "#/$defs/Sha256" }, { "type": "null" }]
        }
      },
      "required": [
        "day",
        "day_revision",
        "archive_revision",
        "projection_schema_version",
        "materializer_version",
        "row_checksum_sha256",
        "content_sha256",
        "byte_size",
        "row_count",
        "min_event_at",
        "max_event_at",
        "first_chain_sequence",
        "last_chain_sequence",
        "last_chain_hash"
      ]
    },
    "RegistrationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": { "const": 2 },
        "schema_version": { "const": 1 },
        "source_epoch": { "$ref": "#/$defs/Uuid" },
        "runtime_instance_id": { "$ref": "#/$defs/Uuid" },
        "device_display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "x-maxUtf8Bytes": 64
        },
        "client_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "materializer_version": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "completeness": { "$ref": "#/$defs/Completeness" },
        "coverage_start": { "$ref": "#/$defs/Timestamp" },
        "baseline_chain_sequence": { "$ref": "#/$defs/NonNegativeSafeInteger" },
        "baseline_chain_hash": { "$ref": "#/$defs/Sha256" },
        "audit_database_generation": { "$ref": "#/$defs/Uuid" },
        "consent": { "$ref": "#/$defs/ConsentReceipt" },
        "signing_public_key": {
          "type": "string",
          "minLength": 43,
          "maxLength": 128
        }
      },
      "required": [
        "protocol_version",
        "schema_version",
        "source_epoch",
        "runtime_instance_id",
        "device_display_name",
        "client_version",
        "materializer_version",
        "completeness",
        "coverage_start",
        "baseline_chain_sequence",
        "audit_database_generation",
        "consent"
      ]
    },
    "RegistrationResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": { "const": 2 },
        "schema_version": { "const": 1 },
        "device_id": { "$ref": "#/$defs/Uuid" },
        "actor_user_id": { "type": "string", "minLength": 1, "maxLength": 128, "x-maxUtf8Bytes": 128 },
        "team_id": { "$ref": "#/$defs/Uuid" },
        "source_epoch": { "$ref": "#/$defs/Uuid" },
        "coverage_start": { "$ref": "#/$defs/Timestamp" },
        "credential_version": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "device_secret": { "type": "string", "minLength": 43, "maxLength": 128 },
        "runtime_lease_expires_at": { "$ref": "#/$defs/Timestamp" },
        "destination_policy": { "$ref": "#/$defs/DestinationPolicy" },
        "server_time": { "$ref": "#/$defs/Timestamp" }
      },
      "required": [
        "protocol_version",
        "schema_version",
        "device_id",
        "actor_user_id",
        "team_id",
        "source_epoch",
        "coverage_start",
        "credential_version",
        "device_secret",
        "runtime_lease_expires_at",
        "destination_policy",
        "server_time"
      ]
    },
    "CredentialRotationRequest": {
      "allOf": [
        { "$ref": "#/$defs/RequestContext" },
        {
          "type": "object",
          "properties": {
            "current_credential_version": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "reason": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "required": ["current_credential_version", "reason"]
        }
      ],
      "unevaluatedProperties": false
    },
    "CredentialRotationResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_id": { "$ref": "#/$defs/Uuid" },
        "credential_version": { "type": "integer", "minimum": 2, "maximum": 65535 },
        "device_secret": { "type": "string", "minLength": 43, "maxLength": 128 },
        "previous_secret_valid_until": { "$ref": "#/$defs/Timestamp" },
        "server_time": { "$ref": "#/$defs/Timestamp" }
      },
      "required": [
        "device_id",
        "credential_version",
        "device_secret",
        "previous_secret_valid_until",
        "server_time"
      ]
    },
    "DeviceRevocationRequest": {
      "allOf": [
        { "$ref": "#/$defs/RequestContext" },
        {
          "type": "object",
          "properties": {
            "reason": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "required": ["reason"]
        }
      ],
