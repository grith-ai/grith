{
  "name": "grith_analytics_projection",
  "schema_version": 1,
  "format": "parquet",
  "compression": "zstd",
  "timestamp_unit": "microseconds",
  "timestamp_timezone": "UTC",
  "row_group_target_rows": 65536,
  "fields": [
    {"position":1,"name":"protocol_version","physical_type":"INT32","logical_type":"INT(16,false)","nullable":false,"constant":2},
    {"position":2,"name":"schema_version","physical_type":"INT32","logical_type":"INT(16,false)","nullable":false,"constant":1},
    {"position":3,"name":"materializer_version","physical_type":"INT32","logical_type":"INT(16,false)","nullable":false},
    {"position":4,"name":"event_id","physical_type":"FIXED_LEN_BYTE_ARRAY(16)","logical_type":"UUID","nullable":false},
    {"position":5,"name":"occurred_at","physical_type":"INT64","logical_type":"TIMESTAMP(MICROS,true)","nullable":false},
    {"position":6,"name":"team_id","physical_type":"FIXED_LEN_BYTE_ARRAY(16)","logical_type":"UUID","nullable":false},
    {"position":7,"name":"actor_user_id","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":false,"max_utf8_bytes":128},
    {"position":8,"name":"device_id","physical_type":"FIXED_LEN_BYTE_ARRAY(16)","logical_type":"UUID","nullable":false},
    {"position":9,"name":"source_epoch","physical_type":"FIXED_LEN_BYTE_ARRAY(16)","logical_type":"UUID","nullable":false},
    {"position":10,"name":"session_id","physical_type":"FIXED_LEN_BYTE_ARRAY(16)","logical_type":"UUID","nullable":true},
    {"position":11,"name":"project","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":false,"max_utf8_bytes":128},
    {"position":12,"name":"profile_id","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":false,"max_utf8_bytes":64},
    {"position":13,"name":"profile_version","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":false,"max_utf8_bytes":64},
    {"position":14,"name":"config_hash","physical_type":"FIXED_LEN_BYTE_ARRAY(32)","logical_type":null,"nullable":false},
    {"position":15,"name":"policy_version","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":false,"max_utf8_bytes":64},
    {"position":16,"name":"auto_allow_threshold_micros","physical_type":"INT64","logical_type":null,"nullable":false,"minimum":-100000000,"maximum":100000000},
    {"position":17,"name":"auto_deny_threshold_micros","physical_type":"INT64","logical_type":null,"nullable":false,"minimum":-100000000,"maximum":100000000},
    {"position":18,"name":"queue_policy","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":false,"max_utf8_bytes":64},
    {"position":19,"name":"team_default_config_version","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":false,"max_utf8_bytes":64},
    {"position":20,"name":"supervised_tool","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":false,"max_utf8_bytes":64},
    {"position":21,"name":"completeness","physical_type":"BYTE_ARRAY","logical_type":"ENUM","nullable":false,"registry":"registries.json#completeness_tiers"},
    {"position":22,"name":"record_class","physical_type":"BYTE_ARRAY","logical_type":"ENUM","nullable":false,"registry":"registries.json#record_classes"},
    {"position":23,"name":"category","physical_type":"BYTE_ARRAY","logical_type":"ENUM","nullable":false,"registry":"registries.json#categories"},
    {"position":24,"name":"initial_verdict","physical_type":"BYTE_ARRAY","logical_type":"ENUM","nullable":true,"registry":"registries.json#verdicts"},
    {"position":25,"name":"score_micros","physical_type":"INT64","logical_type":null,"nullable":true,"minimum":-100000000,"maximum":100000000},
    {"position":26,"name":"filter_set_version","physical_type":"INT32","logical_type":"INT(16,false)","nullable":true},
    {"position":27,"name":"evaluated_filter_ids","physical_type":"LIST<BYTE_ARRAY>","logical_type":"LIST<STRING>","nullable":false,"max_items":64,"items_max_utf8_bytes":64,"ordering":"ascending UTF-8 bytes unique"},
    {"position":28,"name":"positive_filter_contributions","physical_type":"LIST<STRUCT<filter_id:BYTE_ARRAY,score_micros:INT64>>","logical_type":null,"nullable":false,"max_items":64,"ordering":"filter_id ascending UTF-8 bytes unique","constraint":"score_micros > 0 and filter_id is evaluated"},
    {"position":29,"name":"enforcement_outcome_code","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":true,"max_utf8_bytes":64},
    {"position":30,"name":"provider","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":true,"max_utf8_bytes":32},
    {"position":31,"name":"model","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":true,"max_utf8_bytes":128},
    {"position":32,"name":"prompt_tokens","physical_type":"INT64","logical_type":"INT(64,false)","nullable":true},
    {"position":33,"name":"completion_tokens","physical_type":"INT64","logical_type":"INT(64,false)","nullable":true},
    {"position":34,"name":"cost_micros","physical_type":"INT64","logical_type":"INT(64,false)","nullable":true},
    {"position":35,"name":"currency","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":true,"constant_when_present":"USD"},
    {"position":36,"name":"price_source","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":true,"max_utf8_bytes":64},
    {"position":37,"name":"pricing_version","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":true,"max_utf8_bytes":64},
    {"position":38,"name":"destination_kind","physical_type":"BYTE_ARRAY","logical_type":"ENUM","nullable":true,"values":["domain","host_port","url_origin","unix_socket_class","other"]},
    {"position":39,"name":"destination_hmac","physical_type":"FIXED_LEN_BYTE_ARRAY(32)","logical_type":null,"nullable":true},
    {"position":40,"name":"destination_hmac_key_version","physical_type":"INT32","logical_type":"INT(16,false)","nullable":true},
    {"position":41,"name":"approved_destination_label","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":true,"max_utf8_bytes":128,"policy":"prospective clear-label opt-in only"},
    {"position":42,"name":"security_event_type","physical_type":"BYTE_ARRAY","logical_type":"ENUM","nullable":true,"values":["queue","deny","canary","gap"]},
    {"position":43,"name":"security_event_revision","physical_type":"INT32","logical_type":"INT(32,false)","nullable":true},
    {"position":44,"name":"resolution_status","physical_type":"BYTE_ARRAY","logical_type":"ENUM","nullable":true,"values":["pending","approved","denied","expired","escalated"]},
    {"position":45,"name":"resolved_at","physical_type":"INT64","logical_type":"TIMESTAMP(MICROS,true)","nullable":true},
    {"position":46,"name":"resolution_code","physical_type":"BYTE_ARRAY","logical_type":"STRING","nullable":true,"max_utf8_bytes":64},
    {"position":47,"name":"gap_count","physical_type":"INT64","logical_type":"INT(64,false)","nullable":true},
    {"position":48,"name":"chain_sequence","physical_type":"INT64","logical_type":"INT(64,false)","nullable":true},
    {"position":49,"name":"chain_hash","physical_type":"FIXED_LEN_BYTE_ARRAY(32)","logical_type":null,"nullable":true},
    {"position":50,"name":"audit_hash_version","physical_type":"INT32","logical_type":"INT(8,false)","nullable":false,"minimum":3}
  ],
  "sort_order": ["occurred_at ASC", "chain_sequence ASC NULLS LAST", "event_id ASC"],
  "uniqueness": ["team_id", "device_id", "source_epoch", "event_id"],
  "conditional_requirements": [
    "decision requires initial_verdict, score_micros, filter_set_version and canonical evaluated_filter_ids",
    "llm_usage requires provider, model, prompt_tokens, completion_tokens, cost_micros, currency, price_source and pricing_version",
    "destination_hmac, destination_hmac_key_version and destination_kind are all present or all absent",
    "security_event_type queue or deny requires initial_verdict",
    "security_event_type gap requires positive gap_count",
    "resolution_status other than pending requires resolved_at"
  ],
  "manifest_binding": {
    "identity": ["team_id", "device_id", "source_epoch", "day", "archive_revision"],
    "fields": [
      "day_revision",
      "projection_schema_version",
      "materializer_version",
      "row_checksum_sha256",
      "object_key",
      "object_version",
      "content_sha256",
      "byte_size",
      "row_count",
      "min_event_at",
      "max_event_at",
      "first_chain_sequence",
      "last_chain_sequence",
      "last_chain_hash",
      "uploaded_at",
      "verified_at",
      "activated_at",
      "superseded_at",
      "delete_after",
      "deleted_at"
    ],
    "activation_requires": "the exact accepted day_revision and row_checksum_sha256 plus verified object checksum, encryption metadata and schema",
    "one_active_revision_per": ["team_id", "device_id", "source_epoch", "day"]
  },
  "excluded_fields": [
    "command",
    "arguments",
    "arguments_summary",
    "raw_path",
    "raw_url",
    "prompt",
    "model_response",
    "file_contents",
    "source_code",
    "payload_body",
    "environment_values",
    "task_context",
    "free_form_decision_reason"
  ]
}
