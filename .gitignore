# Rust
/target/
**/*.rs.bk

# Node.js (dashboard)
node_modules/
dashboard/dist/
dashboard/.vite/
dashboard/tsconfig.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment / secrets
.env
.env.*
!.env.example

# Build artifacts
*.wasm
!plugins/**/*.wasm

# CycloneDX SBOMs — generated by `cargo cyclonedx` (make / release CI); never committed
*.cdx.json

# Audit data (local)
*.db
*.db-journal

# OS
Thumbs.db

qa-runs/
local-notes.txt
arm64-smoke-results-grith-arm64-*

# Demo takes (work/demos/player) — per-recording artifacts, not fixtures.
# sample.cast is committed deliberately; real recordings are not.
work/demos/player/*.cast
!work/demos/player/sample.cast
# summary.txt is a committed CURATED end-card (see timeline [summary]); a real
# per-take capture would overwrite it, but the checked-in one keeps the demo
# self-contained. Not ignored.
work/demos/player/generated*.toml
work/demos/player/__pycache__/
pty*.log
# Sink state — holds generated PRIVATE KEYS (ca.key/server.key) and captured
# request bodies. Never commit.
work/demos/player/.sink/
work/demos/player/*-framed.gif
work/demos/player/*-framed.mp4
